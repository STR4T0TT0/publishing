---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<header class="section-header">
  {eyebrow && <p class="eyebrow mono-label">{eyebrow}</p>}

  <h2>{title}</h2>

  {description && <p class="description">{description}</p>}
</header>

<style>
  .section-header {
    margin: 3rem 0 1rem;
  }

  .eyebrow {
    margin: 0 0 0.75rem;
    color: var(--color-accent);
    font-size: 0.72rem;
  }

  h2 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(1.45rem, 4vw, 2.4rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
  }

  .description {
    max-width: 640px;
    margin: 0.85rem 0 0;
    color: var(--color-muted);
    line-height: 1.55;
  }
</style>
