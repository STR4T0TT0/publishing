---
import { getLanguageLabel, languages, type Language } from "../config/i18n";

interface Props {
  currentLang: Language;
  links: Partial<Record<Language, string>>;
}

const { currentLang, links } = Astro.props;
---

<nav class="language-switcher" aria-label="Language switcher">
  {
    languages.map((language) => {
      const href = links[language];
      const isActive = language === currentLang;

      if (!href) {
        return (
          <span class="language-link unavailable" aria-disabled="true">
            {getLanguageLabel(language)}
          </span>
        );
      }

      return (
        <a
          class:list={["language-link", { active: isActive }]}
          href={href}
          aria-current={isActive ? "page" : undefined}
        >
          {getLanguageLabel(language)}
        </a>
      );
    })
  }
</nav>

<style>
  .language-switcher {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .language-link {
    color: var(--color-muted);
    transition: color 160ms ease;
  }

  .language-link:hover,
  .language-link.active {
    color: var(--color-text);
  }

  .language-link.unavailable {
    cursor: not-allowed;
    opacity: 0.35;
  }
</style>
