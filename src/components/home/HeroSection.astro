---
import type { Language } from "../../config/i18n";
import { ui } from "../../data/ui";

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const labels = ui[lang];
---

<section class="hero">
  <p class="eyebrow mono-label">{labels.home.eyebrow}</p>

  <h1>{labels.home.title}</h1>

  <p class="lead">{labels.home.lead}</p>
</section>

<style>
  .hero {
    max-width: 880px;
    padding: 2rem 0 4rem;
  }

  .eyebrow {
    color: var(--color-accent);
    font-size: 0.85rem;
    margin: 0 0 1rem;
  }

  h1 {
    max-width: 900px;
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(2.7rem, 8vw, 6.5rem);
    line-height: 0.95;
    letter-spacing: -0.06em;
  }

  .lead {
    max-width: 720px;
    margin: 2rem 0 0;
    color: var(--color-muted);
    font-size: clamp(1.2rem, 2vw, 1.55rem);
    line-height: 1.45;
  }
</style>
