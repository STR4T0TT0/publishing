---
import { categories } from "../../config/categories";
import type { Language } from "../../config/i18n";
import { ui } from "../../data/ui";
import { getPublishedArticleCountByCategoryFromCollection } from "../../data/articleCollection";
interface Props {
  lang: Language;
}

const { lang } = Astro.props;

//calcule les compteurs avant le JSX parce que fonction est async
const domainItems = await Promise.all(
  Object.values(categories).map(async (category, index) => ({
    category,
    index,
    articleCount: await getPublishedArticleCountByCategoryFromCollection(
      lang,
      category.slug,
    ),
  })),
);

const labels = ui[lang];
---

<section class="domain-section" aria-labelledby="domains-title">
  <div class="section-header">
    <p id="domains-title" class="mono-label">{labels.home.domainsTitle}</p>
  </div>

  <div class="domain-grid">
    {
      domainItems.map(({ category, index, articleCount }) => (
        <a href={`/${lang}/${category.slug}/`} class="domain-card">
          <span class="mono-label">{String(index + 1).padStart(2, "0")}</span>

          <h2>{category.labels[lang]}</h2>

          <p>{category.descriptions[lang]}</p>

          <div class="article-count mono-label">
            {articleCount}{" "}
            {lang === "fr"
              ? articleCount > 1
                ? "articles publiés"
                : "article publié"
              : articleCount > 1
                ? "published articles"
                : "published article"}
          </div>
        </a>
      ))
    }
  </div>
</section>

<style>
  .domain-section {
    margin-top: auto;
  }

  .section-header {
    margin-bottom: 1rem;
    color: var(--color-muted);
    font-size: 0.75rem;
  }

  .domain-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .domain-card {
    display: block;
    padding: 1.25rem;
    border: 1px solid var(--color-border);
    background: rgba(255, 255, 255, 0.025);
    transition:
      border-color 160ms ease,
      background 160ms ease,
      transform 160ms ease;
  }

  .domain-card:hover {
    border-color: rgba(163, 39, 20, 0.7);
    background: var(--color-surface);
    transform: translateY(-2px);
  }

  .domain-card span {
    color: var(--color-accent);
    font-size: 0.75rem;
  }

  .domain-card h2 {
    margin: 1rem 0 0.5rem;
    font-family: var(--font-heading);
    font-size: 1rem;
    letter-spacing: -0.02em;
  }

  .domain-card p {
    margin: 0;
    color: var(--color-muted);
    line-height: 1.5;
  }
  .article-count {
    margin-top: 1.25rem;
    color: var(--color-muted);
    font-size: 0.68rem;
  }
  @media (min-width: 820px) {
    .domain-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
