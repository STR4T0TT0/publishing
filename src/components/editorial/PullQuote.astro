---
interface Props {
  quote: string;
  attribution?: string;
}

const { quote, attribution } = Astro.props;
---

<figure class="pull-quote">
  <blockquote>{quote}</blockquote>

  {attribution && <figcaption class="mono-label">{attribution}</figcaption>}
</figure>

<style>
  .pull-quote {
    margin: 2rem 0;
    padding: 0;
  }

  blockquote {
    margin: 0;
    max-width: 720px;
    color: var(--color-muted);
    font-family: var(--font-body);
    font-size: clamp(1.05rem, 2.2vw, 1.25rem);
    font-style: italic;
    line-height: 1.55;
    letter-spacing: 0;
  }

  blockquote::before {
    content: "“";
    color: var(--color-accent);
    font-style: normal;
  }

  blockquote::after {
    content: "”";
    color: var(--color-accent);
    font-style: normal;
  }

  figcaption {
    margin-top: 0.65rem;
    color: var(--color-muted);
    font-size: 0.72rem;
  }

  @media (max-width: 560px) {
    .pull-quote {
      margin: 1.65rem 0;
    }

    blockquote {
      font-size: 1rem;
      line-height: 1.6;
    }
  }
</style>
