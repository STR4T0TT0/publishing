---
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
import ArticleLayout from "../../../layouts/ArticleLayout.astro";
import { isLanguage, type Language } from "../../../config/i18n";
import { isCategory, type CategorySlug } from "../../../config/categories";
import { render } from "astro:content";

import {
  getPublishedArticleEntriesFromCollection,
  getArticleEntryByRouteFromCollection,
  getArticleTranslationsFromCollection,
  toArticle,
} from "../../../data/articleCollection";

type MdxModule = {
  default: AstroComponentFactory;
};

export async function getStaticPaths() {
  const entries = await getPublishedArticleEntriesFromCollection();

  return entries.map((entry) => ({
    params: {
      lang: entry.data.language,
      category: entry.data.category,
      slug: entry.data.slug,
    },
  }));
}

const langParam = Astro.params.lang;
const categoryParam = Astro.params.category;
const slugParam = Astro.params.slug;

if (!isLanguage(langParam) || !isCategory(categoryParam) || !slugParam) {
  return Astro.redirect("/en/");
}

const lang: Language = langParam;
const category: CategorySlug = categoryParam;

const articleEntry = await getArticleEntryByRouteFromCollection(
  lang,
  category,
  slugParam,
);

if (!articleEntry) {
  return Astro.redirect("/404");
}

const article = toArticle(articleEntry);
const languageLinks = await getArticleTranslationsFromCollection(article);
const { Content } = await render(articleEntry);

---

<ArticleLayout
  lang={lang}
  title={article.title}
  subtitle={article.subtitle}
  description={article.description}
  seoTitle={article.seoTitle}
  seoDescription={article.seoDescription}
  category={article.category}
  slug={article.slug}
  date={article.date}
  readingTime={article.readingTime}
  languageLinks={languageLinks}
  heroImage={article.heroImage}
  ogImage={article.ogImage}
  sourceUrl={article.sourceUrl}
  sourceLabel={article.sourceLabel}
>
  <Content />
</ArticleLayout>
