---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ArticleCard from "../../../components/editorial/ArticleCard.astro";
import { isLanguage, type Language } from "../../../config/i18n";
import {
  categories,
  categorySlugs,
  isCategory,
  type CategorySlug,
} from "../../../config/categories";
import { getArticlesByCategoryFromCollection } from "../../../data/articleCollection";
import { ui } from "../../../data/ui";
import { site } from "../../../config/site";
import CategoryHeader from "../../../components/category/CategoryHeader.astro";
import FeaturedArticle from "../../../components/category/FeaturedArticle.astro";
import CategoryEmptyState from "../../../components/category/CategoryEmptyState.astro";
import CategorySectionHeader from "../../../components/category/CategorySectionHeader.astro";

export function getStaticPaths() {
  return ["en", "fr"].flatMap((lang) =>
    categorySlugs.map((category) => ({
      params: {
        lang,
        category,
      },
    })),
  );
}

const langParam = Astro.params.lang;
const categoryParam = Astro.params.category;

if (!isLanguage(langParam) || !isCategory(categoryParam)) {
  return Astro.redirect("/en/");
}

const lang: Language = langParam;
const category: CategorySlug = categoryParam;
const categoryData = categories[category];
const labels = ui[lang];

const categoryArticles = await getArticlesByCategoryFromCollection(
  lang,
  category,
);
const featuredArticle = categoryArticles.find((article) => article.featured);
const remainingArticles = featuredArticle
  ? categoryArticles.filter((article) => article.slug !== featuredArticle.slug)
  : categoryArticles;

const languageLinks = {
  en: `/en/${category}/`,
  fr: `/fr/${category}/`,
};

const pageTitle = categoryData.labels[lang];
const pageDescription = categoryData.descriptions[lang];
---

<BaseLayout
  lang={lang}
  title={pageTitle}
  description={pageDescription}
  languageLinks={languageLinks}
>
  <CategoryHeader lang={lang} category={category} />

  <section class="article-list" aria-label={pageTitle}>
    {
      categoryArticles.length > 0 ? (
        <>
          {featuredArticle && (
            <FeaturedArticle article={featuredArticle} lang={lang} />
          )}

          {remainingArticles.length > 0 && (
            <>
              <CategorySectionHeader
                eyebrow={lang === "fr" ? "Flux éditorial" : "Editorial stream"}
                title={lang === "fr" ? "Dernières analyses" : "Latest analysis"}
                description={
                  lang === "fr"
                    ? "Travaux récents publiés dans cette catégorie."
                    : "Recent work published in this category."
                }
              />

              <div class="article-grid">
                {remainingArticles.map((article) => (
                  <ArticleCard article={article} lang={lang} />
                ))}
              </div>
            </>
          )}
        </>
      ) : (
        <CategoryEmptyState lang={lang} category={category} />
      )
    }
  </section>
</BaseLayout>

<style>
  .article-list {
    padding-bottom: 4rem;
  }

  .article-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 900px) {
    .article-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
