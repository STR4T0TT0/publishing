---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HeroSection from "../../components/home/HeroSection.astro";
import DomainGrid from "../../components/home/DomainGrid.astro";
import { isLanguage, type Language } from "../../config/i18n";
import { site } from "../../config/site";
import HomeFeaturedArticle from "../../components/home/HomeFeaturedArticle.astro";
import { getFeaturedArticlesByLanguageFromCollection } from "../../data/articleCollection";

export function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "fr" } }];
}

const langParam = Astro.params.lang;

if (!isLanguage(langParam)) {
  return Astro.redirect("/en/");
}

const lang: Language = langParam;

const featuredArticle = (
  await getFeaturedArticlesByLanguageFromCollection(lang)
)[0];

const languageLinks = {
  en: "/en/",
  fr: "/fr/",
};
---

<BaseLayout
  lang={lang}
  title={site.title}
  description={site.description}
  languageLinks={languageLinks}
>
  <HeroSection lang={lang} />
  {
    featuredArticle && (
      <HomeFeaturedArticle article={featuredArticle} lang={lang} />
    )
  }
  <DomainGrid lang={lang} />
</BaseLayout>
